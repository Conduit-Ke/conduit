# Environment Configuration Template
# Copy to .env and fill in production values
# DO NOT commit .env to version control

# Keystore Configuration
KEYSTORE_PASSWORD=android
KEY_PASSWORD=android

# Firebase Configuration
# Replace google-services.json with your Firebase project config
# Download from: https://console.firebase.google.com/project/_/settings/general

# Rule Signing
# Keys are in rule_signing_*.pem
# Rotate every 90 days for security

# Production Recommendations
# 1. Use strong passwords (min 16 chars, alphanumeric + symbols)
# 2. Store secrets in CI/CD environment variables
# 3. Never commit credentials to git
# 4. Use different keystores for debug/release builds
# 5. Enable Firebase App Check for production

# Example CI/CD setup (GitHub Actions):
# - name: Build Release
#   env:
#     KEYSTORE_PASSWORD: ${{ secrets.KEYSTORE_PASSWORD }}
#     KEY_PASSWORD: ${{ secrets.KEY_PASSWORD }}
#   run: ./gradlew assembleRelease
